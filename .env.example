# Copy to .env.local and fill in. Never commit .env.local.

# Anthropic API key: https://console.anthropic.com/settings/keys
ANTHROPIC_API_KEY=

# Composio PROJECT API key (starts with ak_, not the ck_ org key): dashboard -> your project -> Settings -> API Keys
# Used only to read toolkit metadata (managed OAuth or not, scopes).
COMPOSIO_API_KEY=

# Models. Main = research + writing + verification. Fast = resolving app names, classification.
MODEL_MAIN=claude-opus-5
MODEL_FAST=claude-haiku-4-5
# Live generation (website) uses a cheaper model by default.
MODEL_LIVE=claude-sonnet-5

# Storage for live-generated guides (share links). Filled in at Milestone 4.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=

# Abuse guard for the public live-generation endpoint.
RATE_LIMIT_PER_IP_PER_HOUR=10

# Live runs are capped at $1 and thorough runs at $3 (lib/pipeline/profile.ts).
# When a cap is hit, every in-flight model call in that run is cancelled.
